# Showmob local / future-dev placeholders only.
# Copy to `.env` (gitignored) if you later connect a development Supabase project.
# Never put service-role keys, database passwords, or other secrets in VITE_* vars.
# The production Vite app does not read these today; repository JSON remains canonical.

# Public Supabase API URL for a future development project (placeholder).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable anon key only (placeholder). Safe to expose in a browser once RLS
# and deliberate grants are in place. Not used by the current production build.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional server-side live check (scripts/milestone-one-check.mjs). Keep this in
# your shell or password manager — never commit a real value.
# SHOWMOB_DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Optional absolute origin for OG/canonical URLs (build + client).
# SHOWMOB_SITE_URL=https://showmob.vercel.app
# VITE_SITE_URL=https://showmob.vercel.app
