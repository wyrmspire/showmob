{
  "openapi": "3.1.0",
  "info": {
    "title": "Showmob Authoring Actions",
    "version": "1.0.0",
    "description": "Develop private working material and validated artifact JSON. No publication or model execution."
  },
  "servers": [
    {
      "url": "https://showmob.vercel.app"
    }
  ],
  "security": [
    {
      "authoringKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "authoringKey": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/api/authoring/discover": {
      "get": {
        "operationId": "discoverAuthoring",
        "description": "Call first for workflow, limits and supported contracts. Fetch contract=widgets or schema before composition. Search existing repository artifacts with q.",
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Scope denied"
          },
          "404": {
            "description": "Not found in workspace"
          },
          "409": {
            "description": "Stale revision, protocol or retry conflict"
          },
          "422": {
            "description": "Artifact or review invalid"
          },
          "503": {
            "description": "Not configured or unavailable"
          }
        },
        "parameters": [
          {
            "name": "contract",
            "in": "query",
            "required": false,
            "description": "One of learning, sheet, representation, tutorial, widgets, schema; omit for discovery.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search existing content titles and summaries.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Result offset, default 0.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/authoring/runs": {
      "get": {
        "operationId": "getAuthoringRuns",
        "description": "Get a run including its pinned protocol by runId, or search workspace runs with q. Results are workspace-scoped.",
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Scope denied"
          },
          "404": {
            "description": "Not found in workspace"
          },
          "409": {
            "description": "Stale revision, protocol or retry conflict"
          },
          "422": {
            "description": "Artifact or review invalid"
          },
          "503": {
            "description": "Not configured or unavailable"
          }
        },
        "parameters": [
          {
            "name": "runId",
            "in": "query",
            "required": false,
            "description": "Saved run UUID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search run subject.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "List offset, default 0.",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "operationId": "startAuthoringRun",
        "description": "Create a private run. Use a fresh requestId UUID; reuse it only for an identical retry. Save only authorized task-relevant context.",
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Scope denied"
          },
          "404": {
            "description": "Not found in workspace"
          },
          "409": {
            "description": "Stale revision, protocol or retry conflict"
          },
          "422": {
            "description": "Artifact or review invalid"
          },
          "503": {
            "description": "Not configured or unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "brief": {
                    "type": "object",
                    "properties": {
                      "subject": {
                        "type": "string"
                      },
                      "purpose": {
                        "type": "string"
                      },
                      "readerContext": {
                        "type": "string"
                      },
                      "artifactKind": {
                        "type": "string"
                      },
                      "passGoal": {
                        "type": "string"
                      },
                      "assumptions": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "preserve": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "delivery": {
                        "type": "string",
                        "enum": [
                          "page",
                          "working"
                        ]
                      }
                    },
                    "required": [
                      "subject",
                      "purpose",
                      "readerContext",
                      "artifactKind",
                      "passGoal",
                      "assumptions",
                      "preserve",
                      "delivery"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "requestId",
                  "brief"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/authoring/steps": {
      "get": {
        "operationId": "getAuthoringSteps",
        "description": "Get one immutable step output by revision or paginated metadata with after. Inputs always refer to exact saved revisions.",
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Scope denied"
          },
          "404": {
            "description": "Not found in workspace"
          },
          "409": {
            "description": "Stale revision, protocol or retry conflict"
          },
          "422": {
            "description": "Artifact or review invalid"
          },
          "503": {
            "description": "Not configured or unavailable"
          }
        },
        "parameters": [
          {
            "name": "runId",
            "in": "query",
            "required": true,
            "description": "Run UUID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "revision",
            "in": "query",
            "required": false,
            "description": "Fetch the full output of this revision.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "description": "List revisions after this number, default 0.",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "operationId": "saveAuthoringStep",
        "description": "Save a pass with expectedRevision and input revisions. Read discovery instructions first. Review output requires draftRevision, verdict accept/revise, findings array and checks object with purpose, facts, gaps, representation, render inspected/not-inspected and renderEvidence if inspected. An artifact must exactly match its accepted, externally render-inspected draft. Returns conflict when sources changed. Never publish.",
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Scope denied"
          },
          "404": {
            "description": "Not found in workspace"
          },
          "409": {
            "description": "Stale revision, protocol or retry conflict"
          },
          "422": {
            "description": "Artifact or review invalid"
          },
          "503": {
            "description": "Not configured or unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "runId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "stage": {
                    "type": "string",
                    "enum": [
                      "research",
                      "outline",
                      "representation",
                      "section",
                      "draft",
                      "review",
                      "artifact"
                    ]
                  },
                  "key": {
                    "type": "string",
                    "description": "Stable identity within this stage, e.g. main or section/intro. Reusing it supersedes the earlier step."
                  },
                  "inputs": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "maxItems": 30
                  },
                  "summary": {
                    "type": "string",
                    "maxLength": 1000,
                    "description": "Concise decision and evidence summary, not private chain-of-thought."
                  },
                  "output": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "requestId",
                  "runId",
                  "expectedRevision",
                  "stage",
                  "key",
                  "inputs",
                  "summary",
                  "output"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/authoring/validate": {
      "post": {
        "operationId": "validateShowmobArtifact",
        "description": "Validate a complete Showmob schemaVersion 1 artifact before saving a draft. This checks structure only, not usefulness or rendering.",
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Scope denied"
          },
          "404": {
            "description": "Not found in workspace"
          },
          "409": {
            "description": "Stale revision, protocol or retry conflict"
          },
          "422": {
            "description": "Artifact or review invalid"
          },
          "503": {
            "description": "Not configured or unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      }
    }
  }
}
